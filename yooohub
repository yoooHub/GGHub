-- ================== Ghost Mode ==================
local GM_OriginalCharacter
local GM_DupeCharacter

local function enableGhostMode()
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
	GM_OriginalCharacter = player.Character
	GM_OriginalCharacter.Archivable = true
	GM_DupeCharacter = GM_OriginalCharacter:Clone()
	GM_DupeCharacter.Parent = workspace
	GM_DupeCharacter.HumanoidRootPart.CFrame = GM_OriginalCharacter.HumanoidRootPart.CFrame

	for i,v in pairs(GM_OriginalCharacter:GetChildren()) do
		if v:IsA("LocalScript") then
			local clone = v:Clone()
			clone.Disabled = true
			clone.Parent = GM_DupeCharacter
		end
	end

	GM_OriginalCharacter.Humanoid:UnequipTools()
	player.Character = GM_DupeCharacter
	workspace.CurrentCamera.CameraSubject = GM_DupeCharacter.Humanoid

	for i,v in pairs(GM_DupeCharacter:GetChildren()) do
		if v:IsA("LocalScript") then
			v.Disabled = false
		end
	end

	GM_OriginalCharacter.Parent = nil
end

local function disableGhostMode()
	if not GM_OriginalCharacter or not GM_DupeCharacter then return end
	GM_DupeCharacter.Humanoid:UnequipTools()
	player.Character = GM_OriginalCharacter
	GM_OriginalCharacter.Parent = workspace
	GM_OriginalCharacter.HumanoidRootPart.CFrame = GM_DupeCharacter.HumanoidRootPart.CFrame
	workspace.CurrentCamera.CameraSubject = GM_OriginalCharacter.Humanoid

	for i,v in pairs(GM_DupeCharacter:GetChildren()) do
		if v:IsA("LocalScript") then
			v.Disabled = true
		end
	end

	GM_DupeCharacter:Destroy()
	GM_OriginalCharacter = nil
	GM_DupeCharacter = nil
end

Tab:CreateToggle({
	Name = "Ghost Mode",
	CurrentValue = false,
	Callback = function(enabled)
		if enabled then
			enableGhostMode()
		else
			disableGhostMode()
		end
	end
})


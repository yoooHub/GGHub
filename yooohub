local function createNotification(title, text)
	StarterGui:SetCore("SendNotification", {
		Title = title,
		Text = text,
		Duration = CONFIG.NOTIFICATION_DURATION,
	})
end

local function setCharacterTransparency(character, transparency)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.Transparency = transparency
		end
	end
end

local function getHumanoid()
	return player.Character and player.Character:FindFirstChild("Humanoid")
end

local function getHumanoidRootPart()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- Sound
local sound = Instance.new("Sound")
sound.SoundId = CONFIG.SOUND_ID
sound.Volume = 0.5
sound.Parent = player:WaitForChild("PlayerGui")

local function playSound()
	if sound then sound:Play() end
end

-- ================== Rayfield Functions (ไม่แตะต้อง) ==================
-- Invisibility
local function toggleInvisibility()
	if not player.Character then return end
	playerState.isInvisible = not playerState.isInvisible
	playSound()
	if playerState.isInvisible then
		local hrp = getHumanoidRootPart()
		if not hrp then return end
		local savedPosition = hrp.CFrame
		player.Character:MoveTo(CONFIG.INVISIBILITY_POSITION)
		task.wait(0.15)
		local seat = Instance.new("Seat")
		seat.Name = "invischair"
		seat.Anchored = false
		seat.CanCollide = false
		seat.Transparency = 1
		seat.Position = CONFIG.INVISIBILITY_POSITION
		seat.Parent = workspace
		local weld = Instance.new("Weld")
		weld.Part0 = seat
		weld.Part1 = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
		weld.Parent = seat
		task.wait()
		seat.CFrame = savedPosition
		setCharacterTransparency(player.Character, 0.5)
		createNotification("Invisibility ON", "You are now invisible")
	else
		local invisChair = workspace:FindFirstChild("invischair")
		if invisChair then invisChair:Destroy() end
		if player.Character then setCharacterTransparency(player.Character, 0) end
		createNotification("Invisibility OFF", "You are now visible")
	end
end

-- Speed
local function toggleSpeedBoost()
	local humanoid = getHumanoid()
	if not humanoid then return end
	playerState.isSpeedBoosted = not playerState.isSpeedBoosted
	playSound()
	if playerState.isSpeedBoosted then
		humanoid.WalkSpeed = CONFIG.BOOSTED_SPEED
		createNotification("Speed Boost ON", "Speed: "..CONFIG.BOOSTED_SPEED)
	else
		humanoid.WalkSpeed = playerState.originalSpeed
		createNotification("Speed Boost OFF", "Speed: "..playerState.originalSpeed)
	end
end

-- Noclip
local NoclipConnection
local function toggleNoclip()
	playerState.isNoclipping = not playerState.isNoclipping
	playSound()
	if playerState.isNoclipping then
		NoclipConnection = RunService.Stepped:Connect(function()
			if player.Character then
				for _, part in ipairs(player.Character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
		createNotification("Noclip ON", "You can now walk through walls.")
	else
		if NoclipConnection then NoclipConnection:Disconnect() NoclipConnection = nil end
		if player.Character then
			for _, part in ipairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
		end
		createNotification("Noclip OFF", "Collision restored.")
	end
end

-- God Mode
local GodConnection
local function toggleGodMode()
	playerState.isGodMode = not playerState.isGodMode
	playSound()
	if playerState.isGodMode then
		createNotification("☠️ GOD MODE ON", "You are now invincible!")
		GodConnection = task.spawn(function()
			while playerState.isGodMode do
				local char = player.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					local hrp = char:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health < hum.MaxHealth then
						hum.Health = hum.MaxHealth
					end
					if hrp and hrp.Position.Y < -10 then
						hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z)
						hrp.Velocity = Vector3.zero
					end
					for _, obj in ipairs(workspace:GetDescendants()) do
						if obj:IsA("BasePart") then
							local lname = string.lower(obj.Name)
							if lname:find("kill") or lname:find("lava") or lname:find("death") or lname:find("void") then
								obj.CanTouch = false
								obj.CanQuery = false
							end
						end
					end
				end
				task.wait(0.3)
			end
		end)
	else
		createNotification("⚡ GOD MODE OFF", "You can take damage again.")
		playerState.isGodMode = false
		GodConnection = nil
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanTouch = true
				obj.CanQuery = true
			end
		end
	end
end

